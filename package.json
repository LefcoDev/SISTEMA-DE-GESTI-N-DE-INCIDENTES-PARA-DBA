{
  "name": "dba-incident-manager",
  "version": "1.0.2",
  "description": "Aplicación de escritorio para administradores de bases de datos",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "nodemon --watch server --exec ts-node server/src/index.ts",
    "dev:client": "vite",
    "dev:electron": "npm run build:electron-main && wait-on http://localhost:5173 && electron .",
    "build": "npm run build:client && npm run build:server && npm run build:electron",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:electron-main": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run build:electron-main && electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "author": "DBA Tools Team",
  "license": "MIT",
  "build": {
    "appId": "com.dbatools.incidentmanager",
    "productName": "DBA Incident Manager",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LefcoDev",
        "repo": "SISTEMA-DE-GESTI-N-DE-INCIDENTES-PARA-DBA"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/dist/**/*",
      "node_modules/**/*",
      "public/**/*",
      "icon/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "INSTALACION.md",
        "to": "INSTALACION.md"
      }
    ],
    "win": {
      "icon": "icon/base-de-datos.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DBA Incident Manager"
    },
    "mac": {
      "icon": "icon/base-de-datos.ico",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "icon/base-de-datos.ico",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "1.7.17",
    "@heroicons/react": "2.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "5.17.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "@types/nodemailer": "^7.0.4",
    "axios": "1.6.5",
    "bcrypt": "5.1.1",
    "clsx": "2.1.0",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "date-fns": "3.0.0",
    "dotenv": "16.3.1",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "express": "4.18.2",
    "express-rate-limit": "7.1.5",
    "express-validator": "7.0.1",
    "file-saver": "2.0.5",
    "helmet": "7.1.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.2",
    "monaco-editor": "0.45.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.7.0",
    "node-cron": "3.0.3",
    "nodemailer": "^7.0.11",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "7.49.0",
    "react-hot-toast": "2.4.1",
    "react-monaco-editor": "0.55.0",
    "react-router-dom": "6.21.0",
    "recharts": "2.10.0",
    "sequelize": "6.35.2",
    "sharp": "^0.34.5",
    "twilio": "^5.11.1",
    "winston": "3.11.0",
    "xlsx": "0.18.5",
    "zod": "3.22.4",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "14.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.16",
    "concurrently": "8.2.2",
    "electron": "28.0.0",
    "electron-builder": "24.9.1",
    "electron-reload": "2.0.0-alpha.1",
    "eslint": "8.56.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "29.7.0",
    "nodemon": "^3.0.2",
    "png-to-ico": "^3.0.1",
    "postcss": "8.4.32",
    "prettier": "3.1.1",
    "sequelize-cli": "^6.6.2",
    "supertest": "6.3.3",
    "tailwindcss": "3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "vite": "5.0.10",
    "wait-on": "^7.2.0"
  }
}
